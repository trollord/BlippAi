SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Contact form delivery. MAIL_USER is both the SMTP login and the From address.
# MAIL_PASS must be a Google app password, not the account password.
# Enquiries always go to m@blippai.com and hello@blippai.com (hardcoded in
# src/lib/mail.server.ts) — there is no MAIL_TO.
MAIL_USER=
MAIL_PASS=

# Optional. Defaults to smtp.gmail.com on port 587 (STARTTLS).
# Port 465 switches to implicit TLS automatically.
MAIL_HOST=
MAIL_PORT=
